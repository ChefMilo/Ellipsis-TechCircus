# Copy to .env and fill in ONLY if you want to switch off the mocks.
# The default (everything unset) runs fully offline with mock LLM + mock search.

# --- LLM (claim extraction) ---
# DASFAX_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# DASFAX_OPENAI_MODEL=gpt-4o-mini

# --- Search (evidence retrieval) ---
# DASFAX_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-...

# --- WS5 tuning (optional; these are the numbers to defend in the pitch) ---
# DASFAX_MAX_CLAIMS=5
# DASFAX_MIN_CHECKWORTHINESS=0.35
# DASFAX_EVIDENCE_PER_CLAIM=3
# DASFAX_DEDUP_THRESHOLD=0.85

# =========================================================================
# WS4 — Tier 2 ML screening
# =========================================================================
# Backend selection:
#   auto        (default) real checkpoints when the weights load, heuristic otherwise
#   huggingface strict — refuse to start rather than silently fall back
#   heuristic   forced offline; what CI uses
# DASFAX_SCREENING_MODE=auto

# Operating thresholds. Both are MEASURED — see `python ws4_eval.py --backend huggingface`.
# 0.40 is chosen on the hard subset of the corpus (realistic content), not the aggregate.
# DASFAX_TEXT_THRESHOLD=0.40
# DASFAX_IMAGE_THRESHOLD=0.70

# Checkpoints. Pin a revision SHA to keep a confusion matrix reproducible.
# DASFAX_BERT_MODEL_NAME=omykhailiv/bert-fake-news-recognition
# DASFAX_IMAGE_MODEL_NAME=Organika/sdxl-detector
# DASFAX_BERT_REVISION=
# DASFAX_IMAGE_REVISION=

# Which class index means "fake". The BERT checkpoint ships NO id2label, so this was
# established empirically (`ws4_eval.py --verify-labels`: index 0, AUROC 1.0000 vs 0.0000).
# Re-run that after any checkpoint or revision change — a wrong value inverts the tier
# silently, scoring fake articles as safe.
# DASFAX_BERT_FAKE_LABEL_INDEX=0

# Latency budgets, derived from `python ws4_bench.py --with-images` (arm64 macOS, single
# user, 3 images: p95 549ms). The image path is network-dominated; 300ms was too tight and
# silently disabled image screening entirely.
# DASFAX_SCREEN_BUDGET_MS=750
# DASFAX_TEXT_BUDGET_MS=250
# DASFAX_IMAGE_BUDGET_MS=700
# DASFAX_IMAGE_FETCH_TIMEOUT_S=4
# DASFAX_MAX_IMAGES_SCREENED=6

# Model lifecycle.
# DASFAX_WARMUP=1                  # load + one forward pass at startup (keeps it out of p95)
# DASFAX_ALLOW_MODEL_DOWNLOAD=1    # 0 = use only weights already in the HF cache

# Some hosts reject unrecognised agents (Wikimedia returns HTTP 400 without a contact URL).
# DASFAX_IMAGE_USER_AGENT=Dasfax/0.1 (+https://your-project-url)
