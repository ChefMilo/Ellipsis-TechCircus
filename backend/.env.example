# Copy to backend/.env and fill in ONLY what you want to change. Every var below has a
# working default — an unset/absent backend/.env runs fully offline: mock LLM + mock
# search + mock assessor, no API key, none of the optional packages installed, Tier 2
# off, and `docker compose up` serves a healthy backend with zero setup.
#
# This list was produced by grepping the whole backend/ tree for os.environ.get(...) —
# not by guessing — across both files that read env vars: app/config.py (WS5/WS6) and
# app/orchestrator/config.py (WS3). See docs/ws3/WS3-DEPLOY.md for the exact grep. No real
# credentials appear anywhere in this file or in this repo's git history (verified
# across every branch — docs/ws3/WS3-DEPLOY.md).

# ============================================================================
# app/config.py — WS5 (claim extraction, evidence retrieval) / WS6 (assessment)
# ============================================================================

# Which claim-extraction backend to use. "mock" needs no key; a heuristic sentence
# classifier stands in for a real LLM. DASFAX_LLM_PROVIDER=openai | anthropic
DASFAX_LLM_PROVIDER=mock

# Which evidence-search backend to use. "mock" fabricates *.example.org snippets —
# never present them as real citations. DASFAX_SEARCH_PROVIDER=tavily | anthropic
DASFAX_SEARCH_PROVIDER=mock

# Which per-claim assessor to use. "mock" pattern-matches the mock search client's own
# stance prefixes — it is a rendering fixture, not real assessment (its own module
# docstring says so). DASFAX_ASSESSOR_PROVIDER=openai | anthropic
DASFAX_ASSESSOR_PROVIDER=mock

# Demo/presentation only: cycles the mock search client through 4 fixed stance
# profiles per claim so an offline run visibly exercises every assessable WS6 status.
# Off by default; changes nothing about a normal mock run. 1/true/yes/on to enable.
DASFAX_MOCK_DEMO=

# The key for whichever OpenAI-*compatible* endpoint DASFAX_OPENAI_BASE_URL points at
# (OpenAI itself, or Gemini/Groq/vLLM/etc. speaking the same wire format). Only read
# when DASFAX_LLM_PROVIDER=openai or DASFAX_ASSESSOR_PROVIDER=openai.
OPENAI_API_KEY=

# Base URL for the above. Defaults to real OpenAI; point it at
# https://generativelanguage.googleapis.com/v1beta/openai/ for Gemini, or
# https://api.groq.com/openai/v1 for Groq — no code change either way.
DASFAX_OPENAI_BASE_URL=https://api.openai.com/v1

# Model name for the endpoint above (e.g. gpt-4o-mini, gemini-2.0-flash,
# llama-3.3-70b-versatile — must match whichever DASFAX_OPENAI_BASE_URL you set).
DASFAX_OPENAI_MODEL=gpt-4o-mini

# API key for Tavily search. Only read when DASFAX_SEARCH_PROVIDER=tavily.
TAVILY_API_KEY=

# ----------------------------------------------------------------------------
# Anthropic (one key does everything)
# ----------------------------------------------------------------------------
# The native Messages API path. Setting all three providers to "anthropic" runs the whole
# real pipeline - read (extraction), verify (assessment) AND search (evidence retrieval) -
# on ANTHROPIC_API_KEY alone, because Claude's web_search is a built-in server tool.
# NO OpenAI key and NO Tavily key are read on this path; leave both blank.
#
#   DASFAX_LLM_PROVIDER=anthropic
#   DASFAX_SEARCH_PROVIDER=anthropic
#   DASFAX_ASSESSOR_PROVIDER=anthropic

# The Anthropic key. Only read when one of the three providers above is "anthropic".
ANTHROPIC_API_KEY=

# Claude model for all three anthropic providers. Set this to a model your key actually
# has access to (e.g. claude-sonnet-5, claude-opus-5, claude-haiku-4-5).
DASFAX_ANTHROPIC_MODEL=claude-sonnet-5

# Dated version of Anthropic's web_search server tool. Keys differ on which versions they
# accept; newer ones the SDK knows about are web_search_20260209 and web_search_20260318.
# Only read when DASFAX_SEARCH_PROVIDER=anthropic.
DASFAX_ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# Top-N load-bearing factual claims WS5 keeps after ranking (proposal range: 3-5).
DASFAX_MAX_CLAIMS=5

# Checkworthiness floor [0.0-1.0]; factual claims scoring below this are dropped
# before ranking.
DASFAX_MIN_CHECKWORTHINESS=0.35

# Minimum evidence snippets WS5 tries to retrieve per kept claim.
DASFAX_EVIDENCE_PER_CLAIM=3

# Token-Jaccard similarity [0.0-1.0] above which two extracted claims are treated as
# near-duplicates and collapsed to one.
DASFAX_DEDUP_THRESHOLD=0.85

# Minimum Sørensen-Dice token similarity [0.0-1.0] required to anchor a
# rewritten/paraphrased claim back onto its source sentence.
DASFAX_ANCHOR_MIN_SIMILARITY=0.5

# ============================================================================
# app/orchestrator/config.py — WS3 (POST /analyze: Tier 2 gate, Tier 3 timeout, cache)
# ============================================================================

# Tier 2 screening gate for /analyze. WIRED to the real WS4 screener
# (app/orchestrator/tier2.py -> app/pipeline/ws4.py): BERT text classifier + AI-image
# CNN in parallel, ~750ms budget. Verified live end to end — ordinary news scores 0.005
# and stops at Tier 2 in 34ms; a sensational fake scores 0.999, escalates in 46ms, and
# Tier 3 returns high_risk.
#
# STILL OFF BY DEFAULT, because turning it on changes what the product DOES, not just
# how fast it is: when Tier 2 clears a page, Tier 3 NEVER RUNS for it and the reader
# gets UNRATED with no claims. The text half flags 0.0% (heuristic) to 10.6% (our
# fine-tune) of ordinary news, so with this on, most real articles are never
# fact-checked. That is correct cascade behaviour and a bad surprise mid-demo.
#
# It also does not pay for itself on the default mock stack — measured, Tier 2 adds
# ~16ms while mock Tier 3 costs ~1ms, so ON is *slower* here. The saving only appears
# against the real provider path, where Tier 3 is ~11 sequential model calls.
# Turn it on together with real providers, not before.
#
# (The 83% figure in docs/ws3/RECON.md §10.3 measured omykhailiv/bert-fake-news-
# recognition off the shelf, which is why that checkpoint was abandoned; it does not
# describe what runs today. See backend/WS4.md.) 1/true/yes/on to enable.
DASFAX_TIER2_ENABLED=

# Outer wall-clock bound, in seconds, on the Tier 2 screen. WS4 enforces its own 750ms
# deadline internally (DASFAX_SCREEN_BUDGET_MS); this is the orchestrator's independent
# guard for a screen that hangs past it — a wedged image fetch, a cold model load.
# Exceeding it fails open to Tier 3, never suppresses the fact-check.
DASFAX_TIER2_TIMEOUT_S=5.0

# Wall-clock budget, in seconds, for the Tier 3 step (WS5 extraction + WS6 assessment)
# inside one POST /analyze call. Sized for the REAL provider path, which runs ~11
# sequential model calls (one search + one assessment per kept claim); the mocks finish
# in milliseconds and never come near it. Deliberately shorter than the extension's own
# 130s client-side fetch timeout (src/background/config.ts) so the backend fails first,
# with a real errors[] entry, instead of the extension's generic "unreachable".
# Lower it (e.g. 30) for an all-mock run where a hang should surface quickly.
DASFAX_TIER3_TIMEOUT_S=120.0

# How long, in seconds, a successfully-assembled /analyze response is served from the
# in-memory cache before a repeat (url, text) request re-runs Tier 3. Failed results
# are never cached regardless of this value.
DASFAX_CACHE_TTL_S=300.0

# =========================================================================
# WS4 — Tier 2 ML screening
# =========================================================================
# Backend selection. Text and image resolve INDEPENDENTLY, because the two halves are in
# different states: the image CNN measurably works, no text checkpoint does.
#   auto        (default) real checkpoint when its weights load, heuristic otherwise
#   huggingface strict — refuse to start rather than silently fall back
#   heuristic   forced offline; what CI uses
# DASFAX_TEXT_MODE=auto
# DASFAX_IMAGE_MODE=auto
# DASFAX_SCREENING_MODE=heuristic     # fallback for any component left unset

# Operating thresholds. Each backend has its OWN, because their score distributions differ
# by orders of magnitude — one shared value leaves whichever backend runs inert or
# hair-trigger. Both measured: `python ws4_eval.py --realnews`.
# DASFAX_TEXT_THRESHOLD=0.995            # the fine-tuned model
# DASFAX_HEURISTIC_TEXT_THRESHOLD=0.40   # the fallback
# DASFAX_IMAGE_THRESHOLD=0.70

# Checkpoints. The text model is OUR fine-tune, produced by `python train_ws4.py`
# (~27 min, fixed seed). Its 438MB of weights are not in the repo — past GitHub's limit —
# so a fresh clone degrades to the heuristic until you run that command.
# DASFAX_BERT_MODEL_NAME=models/dasfax-tier2-text
# DASFAX_IMAGE_MODEL_NAME=Organika/sdxl-detector
# DASFAX_BERT_REVISION=
# DASFAX_IMAGE_REVISION=

# Which class index means "fake". The BERT checkpoint ships NO id2label, so this was
# established empirically (`ws4_eval.py --verify-labels`: index 0, AUROC 1.0000 vs 0.0000).
# Re-run that after any checkpoint or revision change — a wrong value inverts the tier
# silently, scoring fake articles as safe.
# DASFAX_BERT_FAKE_LABEL_INDEX=0

# Latency budgets, derived from `python ws4_bench.py --with-images` (arm64 macOS, single
# user, 3 images: p95 549ms). The image path is network-dominated; 300ms was too tight and
# silently disabled image screening entirely.
# DASFAX_SCREEN_BUDGET_MS=750
# DASFAX_TEXT_BUDGET_MS=250
# DASFAX_IMAGE_BUDGET_MS=700
# DASFAX_IMAGE_FETCH_TIMEOUT_S=4
# DASFAX_MAX_IMAGES_SCREENED=6

# Model lifecycle.
# DASFAX_WARMUP=1                  # load + one forward pass at startup (keeps it out of p95)
# DASFAX_ALLOW_MODEL_DOWNLOAD=1    # 0 = use only weights already in the HF cache

# Some hosts reject unrecognised agents (Wikimedia returns HTTP 400 without a contact URL).
# DASFAX_IMAGE_USER_AGENT=Dasfax/0.1 (+https://your-project-url)
