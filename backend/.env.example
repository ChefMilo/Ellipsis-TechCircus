# Copy to .env and fill in ONLY if you want to switch off the mocks.
# The default (everything unset) runs fully offline with mock LLM + mock search + mock
# assessor, and needs no API key and none of the optional packages installed.

# --- LLM (claim extraction, WS5) ---
# DASFAX_LLM_PROVIDER=openai

# --- Assessor (per-claim verdicts, WS6) ---
# Same endpoint/model as the extractor; it only ever cites the evidence WS5 retrieved.
# DASFAX_ASSESSOR_PROVIDER=openai

# --- The OpenAI-compatible endpoint used by both of the above ---
# "openai" is the WIRE FORMAT, not the vendor. Any provider that speaks
# /chat/completions works by changing only the base URL + model below.
# OPENAI_API_KEY=sk-...
# DASFAX_OPENAI_BASE_URL=https://api.openai.com/v1
# DASFAX_OPENAI_MODEL=gpt-4o-mini
#
# Google Gemini instead (same two client classes, no code change):
# OPENAI_API_KEY=<your Google AI Studio key>
# DASFAX_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DASFAX_OPENAI_MODEL=gemini-2.0-flash
#
# Groq instead:
# DASFAX_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# DASFAX_OPENAI_MODEL=llama-3.3-70b-versatile

# --- Search (evidence retrieval, WS5) ---
# DASFAX_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-...

# --- WS5 tuning (optional; these are the numbers to defend in the pitch) ---
# DASFAX_MAX_CLAIMS=5
# DASFAX_MIN_CHECKWORTHINESS=0.35
# DASFAX_EVIDENCE_PER_CLAIM=3
# DASFAX_DEDUP_THRESHOLD=0.85
