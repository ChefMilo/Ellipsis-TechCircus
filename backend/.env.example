# Copy to backend/.env and fill in ONLY what you want to change. Every var below has a
# working default — an unset/absent backend/.env runs fully offline: mock LLM + mock
# search + mock assessor, no API key, none of the optional packages installed, Tier 2
# off, and `docker compose up` serves a healthy backend with zero setup.
#
# This list was produced by grepping the whole backend/ tree for os.environ.get(...) —
# not by guessing — across both files that read env vars: app/config.py (WS5/WS6) and
# app/orchestrator/config.py (WS3). See docs/ws3/WS3-DEPLOY.md for the exact grep. No real
# credentials appear anywhere in this file or in this repo's git history (verified
# across every branch — docs/ws3/WS3-DEPLOY.md).

# ============================================================================
# app/config.py — WS5 (claim extraction, evidence retrieval) / WS6 (assessment)
# ============================================================================

# Which claim-extraction backend to use. "mock" needs no key; a heuristic sentence
# classifier stands in for a real LLM. DASFAX_LLM_PROVIDER=openai
DASFAX_LLM_PROVIDER=mock

# Which evidence-search backend to use. "mock" fabricates *.example.org snippets —
# never present them as real citations. DASFAX_SEARCH_PROVIDER=tavily
DASFAX_SEARCH_PROVIDER=mock

# Which per-claim assessor to use. "mock" pattern-matches the mock search client's own
# stance prefixes — it is a rendering fixture, not real assessment (its own module
# docstring says so). DASFAX_ASSESSOR_PROVIDER=openai
DASFAX_ASSESSOR_PROVIDER=mock

# Demo/presentation only: cycles the mock search client through 4 fixed stance
# profiles per claim so an offline run visibly exercises every assessable WS6 status.
# Off by default; changes nothing about a normal mock run. 1/true/yes/on to enable.
DASFAX_MOCK_DEMO=

# The key for whichever OpenAI-*compatible* endpoint DASFAX_OPENAI_BASE_URL points at
# (OpenAI itself, or Gemini/Groq/vLLM/etc. speaking the same wire format). Only read
# when DASFAX_LLM_PROVIDER=openai or DASFAX_ASSESSOR_PROVIDER=openai.
OPENAI_API_KEY=

# Base URL for the above. Defaults to real OpenAI; point it at
# https://generativelanguage.googleapis.com/v1beta/openai/ for Gemini, or
# https://api.groq.com/openai/v1 for Groq — no code change either way.
DASFAX_OPENAI_BASE_URL=https://api.openai.com/v1

# Model name for the endpoint above (e.g. gpt-4o-mini, gemini-2.0-flash,
# llama-3.3-70b-versatile — must match whichever DASFAX_OPENAI_BASE_URL you set).
DASFAX_OPENAI_MODEL=gpt-4o-mini

# API key for Tavily search. Only read when DASFAX_SEARCH_PROVIDER=tavily.
TAVILY_API_KEY=

# Top-N load-bearing factual claims WS5 keeps after ranking (proposal range: 3-5).
DASFAX_MAX_CLAIMS=5

# Checkworthiness floor [0.0-1.0]; factual claims scoring below this are dropped
# before ranking.
DASFAX_MIN_CHECKWORTHINESS=0.35

# Minimum evidence snippets WS5 tries to retrieve per kept claim.
DASFAX_EVIDENCE_PER_CLAIM=3

# Token-Jaccard similarity [0.0-1.0] above which two extracted claims are treated as
# near-duplicates and collapsed to one.
DASFAX_DEDUP_THRESHOLD=0.85

# Minimum Sørensen-Dice token similarity [0.0-1.0] required to anchor a
# rewritten/paraphrased claim back onto its source sentence.
DASFAX_ANCHOR_MIN_SIMILARITY=0.5

# ============================================================================
# app/orchestrator/config.py — WS3 (POST /analyze: Tier 2 gate, Tier 3 timeout, cache)
# ============================================================================

# Tier 2 (BERT text classifier + AI-image detector) screening gate. OFF by default —
# and staying off is a deliberate safety decision, not a placeholder: the only trained
# checkpoint that exists (on the unmerged ws4-tier2-screening branch) flags 83% of
# real news as fake (docs/ws3/RECON.md §10.3). Turning this on today does not run real Tier 2
# screening either way — see app/orchestrator/tier2.py's module docstring; the flag
# only activates a seam that still falls straight through to Tier 3.
# 1/true/yes/on to enable.
DASFAX_TIER2_ENABLED=

# Wall-clock budget, in seconds, for the Tier 3 step (WS5 extraction + WS6 assessment)
# inside one POST /analyze call. Deliberately shorter than the extension's own 15s
# client-side fetch timeout (src/background/config.ts) so the backend fails first,
# with a real errors[] entry, instead of the extension's generic "unreachable".
DASFAX_TIER3_TIMEOUT_S=8.0

# How long, in seconds, a successfully-assembled /analyze response is served from the
# in-memory cache before a repeat (url, text) request re-runs Tier 3. Failed results
# are never cached regardless of this value.
DASFAX_CACHE_TTL_S=300.0
