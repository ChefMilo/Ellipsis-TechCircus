{
  "manifest_version": 3,
  "name": "Dasfax Fact-Check (dev build)",
  "version": "0.2.0",
  "description": "In-page fact-checking: Tier 0/1 triage in the browser, Tier 2 ML screening and Tier 3 claim verification in the backend.",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
